            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "pm.test(\"Metrics contain system and hospital stats\", function () {",
              "  const m = pm.response.json();",
              "  pm.expect(m).to.have.property(\"system\");",
              "  pm.expect(m).to.have.property(\"hospital\");",
