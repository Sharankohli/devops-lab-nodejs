{
  "info": {
    "name": "Healthcare API Tests",
    "description": "Lab 5 – requests and tests for the healthcare REST API (doctors, patients, appointments, metrics).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    }
  ],
  "item": [
    {
      "name": "GET /api/doctors",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "pm.test(\"Response is an array\", function () {",
              "  pm.expect(pm.response.json()).to.be.an(\"array\");",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/doctors",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "doctors"
          ]
        }
      }
    },
    {
      "name": "POST /api/doctors",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 201\", function () {",
              "  pm.response.to.have.status(201);",
              "});",
              "pm.test(\"Response has a generated id\", function () {",
              "  pm.expect(pm.response.json()).to.have.property(\"id\");",
              "});",
              "pm.test(\"Doctor has the sent name and specialty\", function () {",
              "  const d = pm.response.json();",
              "  pm.expect(d.name).to.eql(\"Dr. Julie\");",
              "  pm.expect(d.specialty).to.eql(\"Neurology\");",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Dr. Julie\",\n  \"specialty\": \"Neurology\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api/doctors",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "doctors"
          ]
        }
      }
    },
