    {
      "name": "Patients validation",
      "description": "Run this whole folder in order. Checks creation, validation, generated IDs and persistence using a snapshot of the current patient list.",
      "item": [
        {
          "name": "GET patients before validation tests",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Save the current patient list\", function () {",
                  "  const patients = pm.response.json();",
                  "  pm.expect(patients).to.be.an(\"array\");",
                  "  pm.collectionVariables.set(\"expectedPatients\", JSON.stringify(patients));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/patients",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "patients"
              ]
            }
          }
        },
        {
          "name": "POST patient - trimmed name",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Creates a patient with a trimmed name and integer age\", function () {",
                  "  pm.response.to.have.status(201);",
                  "  pm.response.to.be.json;",
                  "  const sent = JSON.parse(pm.request.body.raw);",
                  "  const patients = JSON.parse(pm.collectionVariables.get(\"expectedPatients\"));",
                  "  const nextId = patients.reduce((max, patient) => Math.max(max, patient.id), 0) + 1;",
                  "  const created = pm.response.json();",
                  "  pm.expect(created).to.eql({ id: nextId, name: sent.name.trim(), age: sent.age });",
                  "  patients.push(created);",
                  "  pm.collectionVariables.set(\"expectedPatients\", JSON.stringify(patients));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/patients",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "patients"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"  Marie  \",\n  \"age\": 29\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
